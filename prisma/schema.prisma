// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mongodb"
  url       = env("MONGODB_URI")
  directUrl = env("MONGODB_URI")
}

// Énumération des types de newsletters
enum NewsletterType {
  GENERAL           // Newsletter générale
  FORMATION         // Formations et certifications
  CYBERSECURITY     // Actualités cybersécurité
  CLOUD             // Technologies cloud
  EARLY_ACCESS      // Accès anticipé aux nouveautés
  ENTERPRISE        // Solutions entreprise
  DEVELOPER         // Ressources développeurs
}

// Énumération des statuts d'abonnement
enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  PENDING_CONFIRMATION
}

// Énumération des sources d'inscription
enum SubscriptionSource {
  HOMEPAGE
  ABOUT_PAGE
  FORMATION_PAGE
  ENTERPRISE_PAGE
  CONTACT_FORM
  POPUP
  FOOTER
  SOCIAL_MEDIA
  REFERRAL
}

// Modèle principal pour les abonnés
model Subscriber {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  email         String                @unique
  firstName     String?               // Prénom (optionnel)
  lastName      String?               // Nom (optionnel)
  company       String?               // Entreprise (optionnel)
  jobTitle      String?               // Poste (optionnel)
  phone         String?               // Téléphone (optionnel)
  
  // Métadonnées techniques
  ipAddress     String
  userAgent     String
  source        SubscriptionSource    @default(HOMEPAGE)
  referrer      String?               // URL de provenance
  
  // Consentements et préférences
  gdprConsent   Boolean               @default(false)
  marketingConsent Boolean            @default(false)
  
  // Statut global
  status        SubscriptionStatus    @default(PENDING_CONFIRMATION)
  emailVerified Boolean               @default(false)
  verificationToken String?
  
  // Relations
  subscriptions NewsletterSubscription[]
  interactions  SubscriberInteraction[]
  
  // Timestamps
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  lastActiveAt  DateTime?
  unsubscribedAt DateTime?
}

// Modèle pour les abonnements aux différentes newsletters
model NewsletterSubscription {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  subscriberId String             @db.ObjectId
  subscriber   Subscriber         @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  
  type         NewsletterType
  status       SubscriptionStatus @default(ACTIVE)
  
  // Préférences spécifiques
  frequency    String?            // daily, weekly, monthly
  tags         String[]           // Tags d'intérêt spécifiques
  
  // Timestamps
  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?
  lastSentAt     DateTime?
  
  @@unique([subscriberId, type])
}

// Modèle pour tracker les interactions des abonnés
model SubscriberInteraction {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  subscriberId String     @db.ObjectId
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  
  type         String     // email_open, email_click, form_submit, page_visit
  data         Json?      // Données additionnelles (URL cliquée, campagne, etc.)
  
  createdAt    DateTime   @default(now())
}

// Modèle pour les campagnes d'email
model EmailCampaign {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  subject       String
  content       String
  newsletterType NewsletterType
  
  // Statistiques
  sentCount     Int            @default(0)
  openCount     Int            @default(0)
  clickCount    Int            @default(0)
  unsubscribeCount Int         @default(0)
  
  // Statut
  status        String         @default("draft") // draft, scheduled, sent
  scheduledAt   DateTime?
  sentAt        DateTime?
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// Modèle pour les templates d'email
model EmailTemplate {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  subject       String
  htmlContent   String
  textContent   String?
  newsletterType NewsletterType
  
  isActive      Boolean        @default(true)
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
