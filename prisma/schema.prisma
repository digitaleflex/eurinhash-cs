// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model ProjectRequest {
  id String @id @default(cuid())

  // Contexte Organisationnel
  organization String
  role         String
  email        String
  phone        String?
  country      String  @default("BJ")
  location     String?

  // Nature de l'Initiative
  initiativeType String
  initiativeName String
  vision         String  @db.Text
  context        String? @db.Text

  // Enjeux & Engagement
  engagementLevel String
  priority        String @default("strategic")
  timeline        String

  // Contraintes Systémiques
  dataSensitivity        String?
  existingInfrastructure String?  @db.Text
  regulatoryRequirements String?  @db.Text
  technologies           String[]

  // Statut et suivi Institutionnel
  status String @default("new") // "new", "analyzing", "qualified", "rejected", "archived"
  source String @default("collaboration_portal")

  // Métadonnées
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_requests")
}
