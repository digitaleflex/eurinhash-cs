// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// better-auth (schéma aligné sur Better Auth 1.x)
// ===========================================

model User {
  id            String    @id @default(cuid())
  name          String    @default("")
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String?   @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  registrations EventRegistration[]

  @@map("users")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model ProjectRequest {
  id String @id @default(cuid())

  // Contexte Organisationnel
  organization String
  role         String
  email        String
  phone        String?
  country      String  @default("BJ")
  location     String?

  // Nature de l'Initiative
  initiativeType String
  initiativeName String
  vision         String  @db.Text
  context        String? @db.Text

  // Enjeux & Engagement
  engagementLevel String
  priority        String @default("strategic")
  timeline        String

  // Contraintes Systémiques
  dataSensitivity        String?
  existingInfrastructure String?  @db.Text
  regulatoryRequirements String?  @db.Text
  technologies           String[]

  // Statut et suivi Institutionnel
  status String @default("new") // "new", "analyzing", "qualified", "rejected", "archived"
  source String @default("collaboration_portal")

  // Métadonnées
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_requests")
}

model Event {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String   @db.Text
  date             DateTime
  type             String   // "Webinar", "Live", "Conférence"
  platform         String   // "TikTok", "YouTube", "Substack", "Google Meet", "Meetup", "Other"
  eventUrl         String
  registrationLink String?
  thumbnail        String?
  isFeatured       Boolean  @default(false)
  status           String   @default("upcoming") // "upcoming", "past", "canceled"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  registrations    EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("event_registrations")
}
