{
  "name": "eurinhash-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio professionnel d'Eurin Hash - Développeur Full Stack & Expert Cloud",
  "author": "Eurin Hash <contact@eurinhash.com>",
  "homepage": "https://eurinhash.com",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:turbo": "next dev --turbopack --port 8080",
    "build": "prisma generate && next build",
    "build:dev": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "security:audit": "npm audit --audit-level=moderate",
    "security:check": "audit-ci --config audit-ci.json",
    "deps:check": "depcheck",
    "deps:outdated": "npm outdated",
    "db:generate": "prisma generate",
    "db:generate:prod": "prisma generate --no-engine",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "6.1.0",
    "@prisma/client": "6.1.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "autoprefixer": "^10.4.21",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.18",
    "geist": "^1.7.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.12",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postcss": "^8.5.6",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.2",
    "resend": "^6.9.2",
    "schema-dts": "^1.1.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "audit-ci": "^7.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "knip": "^6.4.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "prisma": "6.1.0",
    "typescript": "^5",
    "zod": "^4.3.6"
  }
}
